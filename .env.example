# Runtime Environment
NODE_ENV=production
PORT=3000

# Security (Required: strong random string >= 16 characters in production)
JWT_SECRET=replace_with_a_strong_random_secret_generated_via_openssl_rand_hex_32

# Database Persistence (MongoDB Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Use isolated database names for Preview vs Production
MONGODB_DB_NAME=water_tracker

# Optional CORS whitelist (comma-separated origins; leave unset for same-origin defaults)
# ALLOWED_ORIGINS=https://smart-water-tracker.vercel.app,https://mycustomdomain.com

# Legacy SQLite Fallback (local development only)
DATABASE_PATH=./data/water_tracker.db
