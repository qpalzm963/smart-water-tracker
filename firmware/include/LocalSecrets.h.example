// 複製成 LocalSecrets.h 並填入實際值。LocalSecrets.h 已被 .gitignore 排除，
// 不會進版控。沒有這個檔案時韌體照常編譯，只是不會預先帶入 Wi-Fi 設定。
//
// 注意: ESP32-C3 只支援 2.4GHz，且僅支援一般密碼制 (WPA2 Personal)。
// 企業級認證 (WPA2 Enterprise / 802.1X) 無法使用。
#pragma once

#define LOCAL_WIFI_SSID       "你的2.4GHz網路名稱"
#define LOCAL_WIFI_PASS       "在這裡填密碼"

// 選填: 雲端上傳用。留空則只連 Wi-Fi，不上傳。
#define LOCAL_API_BASE_URL    ""
#define LOCAL_DEVICE_TOKEN    ""
